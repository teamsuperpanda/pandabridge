{
  "compilerOptions": {
    "paths": {
      "*": ["./*"]
    },
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2018",
    "allowJs": true,
    "noImplicitAny": false,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "importHelpers": true,
    "declaration": true,
    "outDir": "./lib",
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "DOM",
      "ES2018"
    ]
  },
  "include": [
    "**/*.ts"
  ]
}
