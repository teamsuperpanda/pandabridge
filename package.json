{
  "name": "panda-zap",
  "version": "1.1.1",
  "type": "module",
  "description": "Obsidian plugin with Anki Connect integration by Team Super Panda",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/teamsuperpanda/pandazap"
  },
  "homepage": "https://github.com/teamsuperpanda/pandazap",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "dev": "node esbuild.config.mjs --watch",
    "test": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [],
  "author": "Team Super Panda",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@eslint/json": "^2.0.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.3",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "^1.13.1",
    "prettier": "^3.8.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "vite": {
      ".": "8.0.16",
      "esbuild": "0.28.1"
    },
    "js-yaml": "4.3.1",
    "flatted": "3.4.2",
    "picomatch": "4.0.4",
    "postcss": "8.5.26",
    "yaml": "2.8.4"
  }
}
